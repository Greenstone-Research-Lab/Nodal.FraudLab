@page "/data-upload"
@rendermode InteractiveServer
@inject ICsvImportPreviewService CsvImportPreviewService
@inject IWebHostEnvironment WebHostEnvironment

<PageTitle>Data upload</PageTitle>

<section class="page-heading">
    <p class="eyebrow">SOURCE ONBOARDING</p>
    <h1>Choose a model, then validate its CSV.</h1>
    <p>Each upload has one explicit target model. FraudLab checks the expected header, C# value types, required properties, unique identifiers, and model-specific consistency rules before data can move into the graph.</p>
</section>

<section class="model-selector">
    <div>
        <label for="data-set">Target domain model</label>
        <select id="data-set" @bind="selectedDataSet" @bind:after="ClearPreview">
            @foreach (var model in models)
            {
                <option value="@model.DataSet">@model.DisplayName</option>
            }
        </select>
    </div>
    <p><strong>@selectedModel.DisplayName</strong> — Upload only a CSV shaped for this model. The selected model cannot be inferred or changed by the file.</p>
</section>

<section class="upload-workspace">
    <div class="upload-panel">
        <h2>Upload @selectedModel.DisplayName CSV</h2>
        <p>Choose one CSV file. Its header must match the property table exactly; column order is flexible.</p>
        <InputFile OnChange="HandleUploadAsync" accept=".csv,text/csv" class="file-input" />
        <div class="upload-actions">
            <button class="primary-button" @onclick="LoadBundledDemoAsync" disabled="@isLoading">Load @selectedModel.DisplayName demo</button>
            @if (preview is not null)
            {
                <button class="secondary-button" @onclick="ClearPreview" disabled="@isLoading">Clear preview</button>
            }
        </div>
        <p class="upload-help">Maximum file size: 2 MB. This screen validates only the selected CSV. Cross-model reference checks run when the complete graph import set is submitted.</p>
    </div>

    <aside class="consistency-panel">
        <h2>Consistency checks</h2>
        <ul>
            <li>Required headers are present and no unknown or duplicate headers exist.</li>
            <li>Required values match their declared .NET data types.</li>
            <li><code>Id</code> values are unique within the CSV file.</li>
            <li>Transaction amounts are positive and timestamps include an offset.</li>
        </ul>
    </aside>
</section>

<section class="property-contract">
    <div>
        <p class="eyebrow">CSV CONTRACT</p>
        <h2>@selectedModel.DisplayName properties</h2>
        <p>The column names below form the upload contract. This is the same contract used by the validator.</p>
    </div>
    <div class="table-scroll">
        <table>
            <thead>
                <tr><th>CSV column / property</th><th>.NET type</th><th>Required</th><th>Validation rule</th></tr>
            </thead>
            <tbody>
                @foreach (var property in selectedModel.Properties)
                {
                    <tr>
                        <td><code>@property.Name</code></td>
                        <td><code>@property.DotNetType</code></td>
                        <td>@(property.IsRequired ? "Yes" : "No")</td>
                        <td>@property.ValidationRule</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <p class="upload-status" role="status">@statusMessage</p>
}

@if (preview is not null)
{
    <section class="dataset-preview">
        <header>
            <div>
                <p class="eyebrow">@preview.DataSet</p>
                <h2>@preview.FileName</h2>
            </div>
            <span class="validation-state @(preview.IsReadyForImport ? "validation-state--ready" : "validation-state--review")">
                @(preview.IsReadyForImport ? "Schema and consistency checks passed" : "Needs review")
            </span>
        </header>

        <dl class="dataset-stats">
            <div><dt>Rows read</dt><dd>@preview.TotalRows</dd></div>
            <div><dt>Valid rows</dt><dd>@preview.ValidRows</dd></div>
            <div><dt>Row issues</dt><dd>@preview.InvalidRows</dd></div>
        </dl>

        @if (preview.PreviewRows.Count > 0)
        {
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            @foreach (var column in preview.Columns)
                            {
                                <th>@column</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in preview.PreviewRows)
                        {
                            <tr>
                                @foreach (var column in preview.Columns)
                                {
                                    <td>@row[column]</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (preview.Issues.Count > 0)
        {
            <div class="validation-issues">
                <h3>Validation issues</h3>
                <ul>
                    @foreach (var issue in preview.Issues.Take(10))
                    {
                        <li>@(issue.RowNumber is null ? "File" : $"Row {issue.RowNumber}"): @issue.Message</li>
                    }
                </ul>
                @if (preview.Issues.Count > 10)
                {
                    <p>Only the first ten issues are displayed.</p>
                }
            </div>
        }
    </section>
}

@code {
    private const long MaximumFileBytes = 2 * 1024 * 1024;
    private IReadOnlyList<CsvModelDefinition> models = [];
    private CsvDataSetPreview? preview;
    private FraudDataSetKind selectedDataSet;
    private bool isLoading;
    private string? statusMessage;

    private CsvModelDefinition selectedModel => models.Single(model => model.DataSet == selectedDataSet);

    protected override void OnInitialized()
    {
        models = CsvImportPreviewService.SupportedModels;
        selectedDataSet = models[0].DataSet;
    }

    private async Task HandleUploadAsync(InputFileChangeEventArgs eventArgs)
    {
        isLoading = true;
        statusMessage = null;
        preview = null;

        try
        {
            var file = eventArgs.File;
            await using var stream = file.OpenReadStream(MaximumFileBytes);
            preview = await CsvImportPreviewService.PreviewAsync(stream, file.Name, selectedDataSet);
            statusMessage = "The selected CSV was inspected in memory. No data has been persisted.";
        }
        catch (Exception exception)
        {
            statusMessage = $"The CSV file could not be inspected: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadBundledDemoAsync()
    {
        isLoading = true;
        statusMessage = null;
        preview = null;

        try
        {
            var path = Path.Combine(WebHostEnvironment.WebRootPath, "demo-data", selectedModel.DemoFileName);
            await using var stream = File.OpenRead(path);
            preview = await CsvImportPreviewService.PreviewAsync(stream, selectedModel.DemoFileName, selectedDataSet);
            statusMessage = "The selected model's bundled demo CSV was inspected successfully. No data has been persisted.";
        }
        catch (Exception exception)
        {
            statusMessage = $"The bundled demo data could not be loaded: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ClearPreview()
    {
        preview = null;
        statusMessage = null;
    }
}
